---
import Icon from './Icon.astro';
---

<template data-pip-template>
  <main class="pip-timer" aria-label="Pomodoro timer">
    <div class="timer-clock">
      <svg class="timer-ring" viewBox="0 0 300 300" aria-hidden="true">
        <circle class="ring-track" cx="150" cy="150" r="139" />
        <circle class="ring-progress" data-ring cx="150" cy="150" r="139" pathLength="100" />
      </svg>
      <div class="clock-face">
        <span class="clock-eyebrow" data-pip-mode>Focus</span>
        <span class="countdown" data-countdown role="timer" aria-label="Focus time remaining">25:00</span>
        <span class="clock-caption" data-pip-status>Ready when you are.</span>
      </div>
    </div>
    <div class="pip-controls">
      <button type="button" class="icon-button" data-reset aria-label="Reset timer" title="Reset timer">
        <Icon name="reset" />
      </button>
      <button type="button" class="button button-primary" data-toggle-timer>Start focus</button>
    </div>
    <p class="pip-feedback" data-pip-feedback role="status" hidden></p>
  </main>
</template>
